# =============================================================================
# Incluvia — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# Database (SQLite local — caminho relativo a prisma/)
DATABASE_URL="file:./dev.db"

# Session
SESSION_SECRET="change-this-to-a-random-secret-at-least-32-characters-long"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Avaliação de IA (opcional): habilita "Gerar com o Claude" e a segunda opinião.
# Sem a chave, a Incluvia funciona com respostas coladas e com o simulador de demonstração.
ANTHROPIC_API_KEY=""

# Audit Engine Limits
AUDIT_MAX_PAGES=20
AUDIT_MAX_DEPTH=3
AUDIT_TIMEOUT_MS=120000
AUDIT_MAX_CONCURRENT=2

# Worker
WORKER_POLL_INTERVAL_MS=5000
