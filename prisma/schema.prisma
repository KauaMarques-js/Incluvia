generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("auditor")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  projects           Project[]
  auditRuns          AuditRun[]
  reviewedFindings   Finding[]       @relation("ReviewedBy")
  aiEvaluations      AiEvaluation[]
  reviewedAiFindings AiFinding[]     @relation("AiReviewedBy")

  @@map("users")
}

// ─── Project ─────────────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("active")
  createdById String   @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  targets        AuditTarget[]
  aiEvaluations  AiEvaluation[]

  @@index([createdById])
  @@index([status])
  @@map("projects")
}

// ─── Audit Target ────────────────────────────────────────────────────────────

model AuditTarget {
  id                       String   @id @default(uuid())
  projectId                String   @map("project_id")
  project                  Project  @relation(fields: [projectId], references: [id])
  name                     String
  startUrl                 String   @map("start_url")
  description              String?
  authorizationConfirmedAt DateTime @map("authorization_confirmed_at")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  auditRuns AuditRun[]

  @@index([projectId])
  @@map("audit_targets")
}

// ─── Audit Run ───────────────────────────────────────────────────────────────

model AuditRun {
  id            String    @id @default(uuid())
  targetId      String    @map("target_id")
  target        AuditTarget @relation(fields: [targetId], references: [id])
  status        String    @default("queued")
  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  toolVersion   String?   @map("tool_version")
  configuration String?   @default("{}")
  errorCode     String?   @map("error_code")
  createdById   String    @map("created_by_id")
  createdBy     User      @relation(fields: [createdById], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at")

  findings Finding[]

  @@index([targetId])
  @@index([status])
  @@index([createdById])
  @@map("audit_runs")
}

// ─── Finding ─────────────────────────────────────────────────────────────────

model Finding {
  id              String    @id @default(uuid())
  auditRunId      String    @map("audit_run_id")
  auditRun        AuditRun  @relation(fields: [auditRunId], references: [id])
  ruleId          String    @map("rule_id")
  title           String
  description     String
  impact          String    @default("unknown")
  pageUrl         String    @map("page_url")
  elementSelector String?   @map("element_selector")
  helpUrl         String?   @map("help_url")
  reviewStatus    String    @default("unreviewed") @map("review_status")
  reviewNote      String?   @map("review_note")
  reviewedById    String?   @map("reviewed_by_id")
  reviewedBy      User?     @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([auditRunId])
  @@index([impact])
  @@index([reviewStatus])
  @@map("findings")
}

// ─── AI Evaluation (capacitismo em respostas de IA) ──────────────────────────

model AiEvaluation {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  project       Project  @relation(fields: [projectId], references: [id])
  scenarioId    String   @map("scenario_id")
  scenarioTitle String   @map("scenario_title")
  modelName     String?  @map("model_name")
  modelVersion  String?  @map("model_version")
  prompt        String
  responseText  String   @map("response_text")
  createdById   String   @map("created_by_id")
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now()) @map("created_at")

  findings AiFinding[]

  @@index([projectId])
  @@index([createdById])
  @@map("ai_evaluations")
}

model AiFinding {
  id           String    @id @default(uuid())
  evaluationId String    @map("evaluation_id")
  evaluation   AiEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  ruleId       String    @map("rule_id")
  category     String
  title        String
  description  String
  impact       String    @default("unknown")
  evidence     String?
  helpText     String?   @map("help_text")
  reviewStatus String    @default("unreviewed") @map("review_status")
  reviewNote   String?   @map("review_note")
  reviewedById String?   @map("reviewed_by_id")
  reviewedBy   User?     @relation("AiReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([evaluationId])
  @@index([category])
  @@index([impact])
  @@index([reviewStatus])
  @@map("ai_findings")
}
